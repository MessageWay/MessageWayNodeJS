{
  "include": ["src/**/*.ts", "test/**/*.ts", "vite.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "outDir": "dist",
    "declaration": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  }
}
