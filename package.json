{
  "name": "messageway",
  "version": "1.3.0",
  "description": "MessageWay NodeJS SDK",
  "keywords": [
    "bale",
    "eitaa",
    "gap",
    "igap",
    "ivr",
    "messageway",
    "messenger",
    "otp",
    "rubika",
    "smart",
    "sms"
  ],
  "homepage": "https://github.com/MessageWay/MessageWayNodeJS#readme",
  "bugs": {
    "url": "https://github.com/MessageWay/MessageWayNodeJS/issues"
  },
  "license": "MIT",
  "contributors": [
    "Mojtaba Ghasemzadeh Tehrany",
    "Ehsan Sabet <ehsan.sabet@hotmail.com>",
    "Amirreza Zarkesh <amirreza.zarkesh.23@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MessageWay/MessageWayNodeJS.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test --run",
    "test:watch": "vp test",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "prepack": "vp pack"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite-plus": "^1.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.29.1"
}
